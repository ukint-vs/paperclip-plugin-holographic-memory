{
  "name": "paperclip-plugin-holographic-memory",
  "version": "0.1.0",
  "description": "Paperclip recall plugin with an isolated holographic SQLite memory store.",
  "type": "module",
  "main": "dist/worker.js",
  "types": "dist/worker.d.ts",
  "files": [
    "dist",
    "src",
    "scripts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup src/worker.ts src/manifest.ts src/ui/index.tsx --format esm --dts --clean",
    "seed:paperclip": "tsx scripts/seed-from-paperclip.ts",
    "import:facts": "tsx scripts/import-facts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "memory",
    "holographic",
    "hermes"
  ],
  "license": "MIT",
  "dependencies": {
    "@paperclipai/plugin-sdk": "latest",
    "better-sqlite3": "^11.10.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "pg": "^8.13.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
