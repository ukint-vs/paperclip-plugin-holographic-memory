{
  "name": "paperclip-plugin-holographic-memory",
  "version": "0.4.0",
  "description": "Paperclip recall plugin with an isolated holographic SQLite memory store.",
  "mcpName": "io.github.ukint-vs/paperclip-plugin-holographic-memory",
  "type": "module",
  "main": "dist/worker.js",
  "types": "dist/worker.d.ts",
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server.d.ts",
      "import": "./dist/mcp-server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "paperclip-holographic-memory-mcp": "./dist/mcp-server.js",
    "paperclip-holographic-memory-setup": "./dist/setup-mcp.js"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && shx chmod +x dist/*.js",
    "seed:paperclip": "tsx scripts/seed-from-paperclip.ts",
    "import:facts": "tsx scripts/import-facts.ts",
    "setup:mcp": "tsx scripts/setup-mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "memory",
    "holographic",
    "hermes",
    "mcp"
  ],
  "author": "Vadim Smirnov <ukint-vs@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukint-vs/paperclip-plugin-holographic-memory.git"
  },
  "bugs": {
    "url": "https://github.com/ukint-vs/paperclip-plugin-holographic-memory/issues"
  },
  "homepage": "https://github.com/ukint-vs/paperclip-plugin-holographic-memory#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@paperclipai/plugin-sdk": "2026.428.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "shx": "^0.3.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
